{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/gantt.schema.json",
  "title": "Gantt chart project document",
  "description": "The shape shared by the server save file, the download file and the upload file for a single project.",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "calendar", "view", "tasks", "dependencies"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "revision": { "type": "integer", "minimum": 0 },
    "calendar": {
      "type": "object",
      "required": ["workingDays", "nonWorkingDates", "weekStartsOn"],
      "additionalProperties": false,
      "properties": {
        "workingDays": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 6 }
        },
        "nonWorkingDates": {
          "type": "array",
          "items": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        },
        "weekStartsOn": { "type": "integer", "enum": [0, 1] }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "zoom": { "type": "string", "enum": ["day", "week", "month", "quarter"] },
        "pxPerDay": { "type": ["number", "null"], "minimum": 0.5, "maximum": 80 },
        "showCriticalPath": { "type": "boolean" },
        "showBaseline": { "type": "boolean" },
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": { "$ref": "#/definitions/task" }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/dependency" }
    }
  },
  "definitions": {
    "task": {
      "type": "object",
      "required": ["id", "parentId", "type", "name", "start", "durationDays", "percent", "order"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "parentId": { "type": ["string", "null"] },
        "type": { "type": "string", "enum": ["task", "group", "milestone"] },
        "name": { "type": "string", "maxLength": 200 },
        "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "durationDays": { "type": "number", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "assignee": { "type": "string" },
        "colour": { "type": "string" },
        "notes": { "type": "string", "maxLength": 2000 },
        "collapsed": { "type": "boolean" },
        "order": { "type": "number" },
        "baseline": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "start": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
            "durationDays": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "dependency": {
      "type": "object",
      "required": ["id", "from", "to", "type"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "type": { "type": "string", "enum": ["FS", "SS", "FF", "SF"] },
        "lagDays": { "type": "number" }
      }
    }
  }
}
